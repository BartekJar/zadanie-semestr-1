<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_blue"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:gravity="center"
            android:text="Urządzenia Domowe"
            android:textColor="@color/navy"
            android:textSize="24sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:gravity="center"
            android:text="Autor: 000000000000"
            android:textColor="@color/navy"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_marginEnd="20dp"
                    android:contentDescription="Pralka"
                    android:scaleType="fitCenter"
                    android:src="@drawable/pralka" android:visibility="visible"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.25"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="Pralka"
                    android:textColor="@color/navy"
                    android:textSize="20sp" />

                <EditText
                    android:id="@+id/washNumberInput"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/edit_text_background"
                    android:hint="Podaj nr prania 1..12"
                    android:inputType="number"
                    android:maxLength="2"
                    android:paddingEnd="8dp"
                    android:singleLine="true"
                    android:textColor="@color/navy"
                    android:textColorHint="@color/navy"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/confirmWashButton"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="10dp"
                    android:backgroundTint="@color/royal_blue"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:text="Zatwierdź"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/washNumberStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Numer prania: nie podano"
                    android:textColor="@color/navy"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="30dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <ImageView
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_marginEnd="20dp"
                    android:contentDescription="Odkurzacz"
                    android:scaleType="fitCenter"
                    android:src="@drawable/odkurzacz" android:visibility="visible"/>

            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.25"
                    android:orientation="vertical">

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp"
                        android:text="Odkurzacz"
                        android:textColor="@color/navy"
                        android:textSize="20sp"/>

                <Button
                        android:id="@+id/vacuumToggleButton"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginBottom="10dp"
                        android:layout_marginEnd="10dp"
                        android:backgroundTint="@color/royal_blue"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:text="Włącz"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="14sp"/>

                <TextView
                        android:id="@+id/vacuumStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Odkurzacz wyłączony"
                        android:textColor="@color/navy"
                        android:textSize="14sp"/>

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Status: naładowany"
                        android:textColor="@color/navy"
                        android:textSize="14sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
